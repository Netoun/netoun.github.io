# Security
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Static assets — immutable with long cache (content hashes)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Images — a year like the fonts, but revalidated on reload (names are not hashed: a changed
# image ships under a new filename)
/images/*
  Cache-Control: public, max-age=31536000

# HTML pages — short cache, must revalidate
/*.html
  Cache-Control: public, max-age=0, must-revalidate
