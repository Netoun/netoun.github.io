{
  "name": "netoun-website",
  "version": "0.0.2",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "portless run --name netoun react-router dev",
    "dev:vite": "react-router dev",
    "build": "react-router build",
    "typecheck": "react-router typegen && tsc",
    "lint": "oxlint",
    "fmt": "oxfmt --write",
    "fmt:check": "oxfmt --check",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "knip": "knip",
    "check": "bun run typecheck && bun run lint && bun run fmt:check && bun run test:run",
    "generate-assets": "bun scripts/generate-assets.ts",
    "generate-logo-ascii": "bun scripts/generate-logo-ascii.ts",
    "generate-grain-tile": "bun scripts/generate-grain-tile.ts",
    "generate-sitemap": "echo \"sitemap.xml is emitted by the build (vite.config.ts); alias kept for the Cloudflare Pages build command\""
  },
  "dependencies": {
    "@react-router/node": "^8.4.0",
    "@vanilla-extract/dynamic": "^2.1.5",
    "@vanilla-extract/recipes": "^0.5.7",
    "animejs": "^4.5.0",
    "clsx": "^2.1.1",
    "isbot": "^5.2.2",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.3.0",
    "react-aria-components": "^1.21.1",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@react-router/dev": "^8.4.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.4.2",
    "@types/node": "^24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vanilla-extract/css": "^1.21.2",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "@vitest/ui": "^5.0.2",
    "@webgpu/types": "^0.1.74",
    "happy-dom": "^20.14.5",
    "knip": "^6.38.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "portless": "^0.15.6",
    "sharp": "^0.35.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "packageManager": "bun@1.4.2"
}
