{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(bun run check)",
      "Bash(bun run typecheck)",
      "Bash(bun run lint)",
      "Bash(bun run fmt)",
      "Bash(bun run fmt:check)",
      "Bash(bun run test:run)",
      "Bash(bun run test:run *)",
      "Bash(bun run build)",
      "Bash(bun run knip)",
      "Bash(bunx vitest run *)",
      "Bash(./node_modules/.bin/oxlint *)",
      "Bash(./node_modules/.bin/oxfmt *)"
    ],
    "deny": [
      "Bash(git commit --no-verify *)",
      "Bash(git push --force *)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-and-lint.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
