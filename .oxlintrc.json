{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react", "jsx-a11y", "import", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "env": {
    "builtin": true,
    "browser": true
  },
  "ignorePatterns": ["build/**", ".react-router/**", "public/**"],
  "rules": {
    "react/react-in-jsx-scope": "off",
    "import/default": "off",
    "import/no-unassigned-import": "off",
    "import/no-named-as-default": "off",
    "no-underscore-dangle": "off",
    "vitest/require-mock-type-parameters": "off",

    // React Compiler-era rules: real signals in animation code. The backlog reached 0 on
    // 2026-09-28; every rule that ever warned here now blocks.
    "react/refs": "error",
    "react/set-state-in-effect": "error",
    "react/exhaustive-effect-dependencies": "error",
    "react/memo-dependencies": "error",
    "react/no-array-index-key": "error",
    "react-hooks/exhaustive-deps": "error",
    "no-shadow": "error"
  },
  "overrides": [
    {
      "files": ["app/components/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^(@/|(\\.\\./)+)(features|pages)/",
                "message": "app/components must not import from features/ or pages/ (docs/architecture.md). Pass data in as props."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["app/features/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^(@/|(\\.\\./)+)pages/",
                "message": "app/features must not import from pages/ (docs/architecture.md)."
              }
            ]
          }
        ]
      }
    }
  ]
}
